<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns startup; the manifest sets DPI awareness before any HWND is created. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>屏幕快捷切换栏</AssemblyName>
    <RootNamespace>QuickAppsOverlay</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="QuickAppsOverlay.AppIcon" Condition="Exists('Assets\app.ico')" />
  </ItemGroup>
</Project>
